    "name":        "webchat",
    "label":       "BizCity Webchat",
    "description": "Chat widget + Admin Dashboard + compatibility session management; core owns the shared message contract",
    "version":     "3.0.16",
    "license":     "lite",
    "bundled":     true,
    "requires":    ["knowledge", "intent"],
    "priority":    20,
    "bootstrap":   "bootstrap.php",
    "provides":    [
        "BizCity_WebChat_Database",
        "BizCity_WebChat_Widget",
        "BizCity_Admin_Dashboard"
    ],
    "db_tables":   ["bizcity_webchat_messages"],
    "db_table_owners": {
        "bizcity_webchat_messages": "core/twin-core",
        "bizcity_webchat_sessions": "modules/webchat (quarantine/migration debt)"
    },
    "db_table_lifecycles": {
        "bizcity_webchat_messages": "core_active",
        "bizcity_webchat_sessions": "quarantine",
        "bizcity_webchat_conversations": "quarantine",
        "bizcity_webchat_projects": "retired",
        "bizcity_webchat_tasks": "retired",
        "bizcity_webchat_task_steps": "retired",
        "bizcity_memory_session": "retired"
    }
}
