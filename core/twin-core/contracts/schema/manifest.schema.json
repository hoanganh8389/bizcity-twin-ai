{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/schema/twin-extension-manifest-v1.1.json",
  "title": "BizCity Twin Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "capabilities"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$" },
    "package_role": {
      "enum": ["core", "module", "channel_owner", "framework_integrated", "vertical_extension", "optional_utility", "private_pro_utility", "legacy_adapter", "reference_only"]
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "taxonomy": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": { "enum": ["act", "channel", "view"] }
    },
    "primary_taxonomy": { "enum": ["act", "channel", "view"] },
    "diagnostics": { "type": "boolean" },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contracts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framework": { "type": "string" },
        "php": { "type": "string" },
        "wp": { "type": "string" }
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
              "kind": { "enum": ["action", "filter"] }
            }
          }
        ]
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tables": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,127}$" }
        },
        "changelog": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "storage_context": {
      "$ref": "public/v1/extension-storage-context.schema.json"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
        "agents": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
        "kg_source_adapters": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
        "workflow_blocks": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
        "personas": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
        "output_renderers": { "type": "array", "items": { "$ref": "#/$defs/capability" } }
      }
    },
    "vertical_modes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/verticalMode" }
    },
    "navigation": {
      "type": "array",
      "items": { "$ref": "#/$defs/navigationItem" }
    },
    "setting_panel": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/settingPanelItem" }
    },
    "spine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel": { "$ref": "#/$defs/spineChannel" },
        "crm": { "$ref": "#/$defs/spineCrm" },
        "context_bank": { "$ref": "#/$defs/spineContextBank" },
        "knowledge": { "$ref": "#/$defs/spineKnowledge" },
        "brain": { "$ref": "#/$defs/spineBrain" },
        "mcp": { "$ref": "#/$defs/spineMcp" },
        "action": { "$ref": "#/$defs/spineAction" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probe_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,160}$" }
        },
        "negative_cases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$"
      }
    },
    "scope_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["permission", "scope_level"],
        "properties": {
          "permission": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$"
          },
          "scope_level": { "enum": ["tenant", "site", "user"] }
        }
      }
    },
    "approval_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["send_message", "publish_content", "create_order", "delete_data", "execute_payment"]
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "webhook_signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "algorithm"],
          "properties": {
            "required": { "type": "boolean" },
            "algorithm": { "enum": ["hmac-sha256", "hmac-sha512", "ed25519"] },
            "header": { "type": "string", "maxLength": 120 }
          }
        },
        "secret_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,64}$"
          }
        },
        "network_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow_hosts": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1, "maxLength": 255 }
            },
            "block_private_ranges": { "type": "boolean" }
          }
        },
        "upload_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_mime": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1, "maxLength": 120 }
            },
            "max_bytes": { "type": "integer", "minimum": 1 },
            "scan_required": { "type": "boolean" }
          }
        }
      }
    }
  },
  "$defs": {
    "contractRefList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}@[0-9]+(?:\\.[0-9]+|\\.x){0,2}$" }
    },
    "spineChannel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["producer", "consumer", "none"] },
        "contracts": { "$ref": "#/$defs/contractRefList" },
        "zone": { "enum": ["customer", "admin", "system"] },
        "account_scope": { "enum": ["exact", "single", "multiple", "none"] }
      }
    },
    "spineCrm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["repository_event", "projection", "consumer", "none", "not_applicable"] },
        "owner": { "type": "string", "minLength": 2, "maxLength": 160 },
        "contract": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}@[0-9]+(?:\\.[0-9]+|\\.x){0,2}$" }
      }
    },
    "spineContextBank": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["producer", "consumer", "none", "not_applicable"] },
        "contracts": { "$ref": "#/$defs/contractRefList" },
        "payload_owner": { "enum": ["encrypted_filestore", "business_filestore", "event_stream", "sql_projection", "none"] }
      }
    },
    "spineKnowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["kg_adapter", "retrieval_consumer", "none", "not_applicable"] },
        "contracts": { "$ref": "#/$defs/contractRefList" },
        "owner": { "type": "string", "minLength": 2, "maxLength": 160 }
      }
    },
    "spineBrain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["canonical_runtime", "vertical_mode", "consumer", "none", "not_applicable"] },
        "vertical_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" }
      }
    },
    "spineMcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["tool_consumer", "action_provider", "none"] },
        "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$" } }
      }
    },
    "spineAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "side_effects": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" } },
        "mutation_contract": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}@[0-9]+(?:\\.[0-9]+|\\.x){0,2}$" },
        "runtime_policy": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}@[0-9]+(?:\\.[0-9]+|\\.x){0,2}$" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 500 },
        "class": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_\\\\]*$" },
        "schema": { "type": "object" },
        "primary": { "type": "boolean" },
        "idempotency": { "type": "boolean" },
        "zone": { "enum": ["customer", "admin"] },
        "artifact_type": { "type": "string" },
        "side_effects": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verticalMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "role", "output_shape", "guest_allowed", "min_plan", "registry_filter"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "role": { "type": "string", "minLength": 1, "maxLength": 500 },
        "output_shape": { "type": "string", "enum": ["narrative", "list_and_narrative", "table_and_narrative"] },
        "guest_allowed": { "type": "boolean" },
        "min_plan": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" },
        "registry_filter": { "type": "string", "const": "bizcity_twinbrain_vertical_bridge_registry" },
        "mpr_layers": { "type": "array", "items": { "type": "integer", "enum": [2, 5] }, "minItems": 1, "uniqueItems": true },
        "automation_mode": { "type": "string", "enum": ["built_in_mpr", "user_workflow", "hybrid_declared"] },
        "channel_entry": { "type": "string" },
        "admin_surface": { "type": "string" },
        "allowed_tools": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" }, "uniqueItems": true }
      }
    },
    "navigationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "label", "group", "slot", "parent", "capability", "position", "scope", "surface", "renderer", "visible", "origin"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,80}$" },
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "group": { "enum": ["settings", "workspace", "diagnostics"] },
        "slot": {
          "enum": [
            "settings.api",
            "settings.chatbot",
            "settings.templates",
            "settings.sync",
            "settings.integrations",
            "workspace.chat",
            "workspace.profile",
            "workspace.knowledge",
            "workspace.crm",
            "workspace.channels",
            "workspace.automation",
            "workspace.studio",
            "workspace.account",
            "workspace.extensions",
            "diagnostics.runtime",
            "diagnostics.logs",
            "diagnostics.schema",
            "diagnostics.probes",
            "diagnostics.extensions"
          ]
        },
        "parent": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" },
        "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){0,4}$" },
        "position": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "scope": { "enum": ["site", "network", "both"] },
        "surface": { "enum": ["admin_shell", "admin_page", "diagnostics"] },
        "renderer": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" },
        "visible": { "type": "boolean" },
        "origin": { "enum": ["core", "bundle", "extension"] },
        "zone": { "enum": ["customer", "admin", "system"] },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" }
        },
        "legacy_parents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" }
        }
      }
    },
    "settingPanelItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "version", "id", "owner", "origin", "destination", "group", "label_key", "icon", "capability", "scope", "surface", "renderer", "availability", "position"],
      "properties": {
        "contract": { "const": "setting-panel-registration" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" },
        "owner": { "type": "string", "minLength": 2, "maxLength": 160 },
        "origin": { "enum": ["core", "module", "bundle", "extension", "legacy_adapter"] },
        "destination": { "enum": ["workspace", "settings", "control-panel", "channel-settings", "crm-inbox", "plugins-store"] },
        "group": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,80}$" },
        "label_key": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,160}$" },
        "description_key": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,160}$" },
        "icon": { "type": "string", "pattern": "^cil-[a-z0-9-]+$" },
        "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){0,4}$" },
        "scope": { "enum": ["site", "network", "user", "site_user"] },
        "surface": { "enum": ["admin_shell", "admin_page", "network_admin", "external"] },
        "renderer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "enum": ["coreui", "route", "embed", "deep_link", "external"] },
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" },
            "canonical_slug": { "type": "string", "pattern": "^[a-z][a-z0-9._/-]{2,160}$" },
            "route": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]*$" },
            "target_url": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?:/[^\\s]*)?$" },
            "allowed_query_keys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" } },
            "shell_mode": { "enum": ["detail", "full", "external"] }
          }
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": {
            "policy": { "enum": ["registered-owner", "all", "any", "always"] },
            "dependency_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" } },
            "min_framework": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "min_php": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
            "min_wp": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
          }
        },
        "position": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "keywords": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9 _.-]{0,63}$" } },
        "badge": { "enum": ["new", "beta", "pro", "update", "deprecated"] },
        "zone": { "enum": ["customer", "admin", "system"] },
        "plan": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" },
        "required": { "type": "boolean" },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9._/-]{2,160}$" } },
        "native_contract": { "type": "boolean" },
        "migration_owner": { "type": "string", "minLength": 2, "maxLength": 160 },
        "sunset_after": { "type": "string", "pattern": "^[A-Z0-9._-]{2,80}$" }
      }
    }
  }
}
