{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/schema/twin/contracts/v1/context-app.schema.json",
  "title": "BizCity Twin Context App",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "key", "label", "entity", "provider", "applies_to", "surfaces", "position", "render", "rest"],
  "properties": {
    "contract": { "const": "context-app" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "icon": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$" },
    "entity": { "type": "string", "maxLength": 120 },
    "provider": { "type": "string", "pattern": "^(|[a-z][a-z0-9._-]{2,100})$" },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_roles", "pipeline_kinds", "capability", "channels"],
      "properties": {
        "subject_roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^\\*|[a-z][a-z0-9._-]{1,63}$" } },
        "pipeline_kinds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$" } },
        "capability": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,100}$" },
        "channels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^\\*|[a-z][a-z0-9._-]{1,63}$" } }
      }
    },
    "surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["b2", "c"] } },
    "position": { "type": "integer", "minimum": 0, "maximum": 9999 },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["component", "route", "embed"] },
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,100}$" }
      }
    },
    "rest": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^/[A-Za-z0-9._{}?=&/-]*$" } },
    "guide": { "type": "string", "maxLength": 160 }
  }
}
