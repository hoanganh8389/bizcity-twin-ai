{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/schema/twin/contracts/v1/extension-manifest.schema.json",
  "title": "BizCity Twin Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x_[a-z][a-z0-9._-]{1,63}$": {}
  },
  "required": [
    "contract",
    "version",
    "extension_id",
    "extension_version",
    "requires_framework",
    "capabilities",
    "channels",
    "diagnostics"
  ],
  "properties": {
    "contract": { "const": "extension-manifest" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "extension_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,63}$"
    },
    "extension_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "requires_framework": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{2,80}$"
      }
    },
    "setting_panel": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract", "version", "id", "owner", "origin", "destination", "group", "label_key", "icon", "capability", "scope", "surface", "renderer", "availability", "position"],
        "properties": {
          "contract": { "const": "setting-panel-registration" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" },
          "owner": { "type": "string", "minLength": 2, "maxLength": 160 },
          "origin": { "enum": ["core", "module", "bundle", "extension", "legacy_adapter"] },
          "destination": { "enum": ["workspace", "settings", "control-panel", "channel-settings", "crm-inbox", "plugins-store"] },
          "group": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,80}$" },
          "label_key": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,160}$" },
          "icon": { "type": "string", "pattern": "^cil-[a-z0-9-]+$" },
          "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){0,4}$" },
          "scope": { "enum": ["site", "network", "user", "site_user"] },
          "surface": { "enum": ["admin_shell", "admin_page", "network_admin", "external"] },
          "renderer": { "type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": { "type": { "enum": ["coreui", "route", "embed", "deep_link", "external"] }, "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" }, "canonical_slug": { "type": "string", "pattern": "^[a-z][a-z0-9._/-]{2,160}$" }, "route": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]*$" }, "target_url": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?:/[^\\s]*)?$" }, "shell_mode": { "enum": ["detail", "full", "external"] } } },
          "availability": { "type": "object", "additionalProperties": false, "required": ["policy"], "properties": { "policy": { "enum": ["registered-owner", "all", "any", "always"] }, "dependency_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" } } } },
          "position": { "type": "integer", "minimum": 0, "maximum": 9999 },
          "zone": { "enum": ["customer", "admin", "system"] },
          "required": { "type": "boolean" },
          "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9._/-]{2,160}$" } }
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "platform",
          "zone",
          "identity_policy",
          "account_scope",
          "crm_policy",
          "brain_policy",
          "context_policy",
          "surface_policy"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{2,63}$"
          },
          "platform": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,31}$"
          },
          "zone": { "enum": ["customer", "admin"] },
          "identity_policy": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{2,80}$"
          },
          "account_scope": { "enum": ["single", "multiple"] },
          "crm_policy": { "enum": ["enabled", "disabled", "not_applicable"] },
          "brain_policy": { "enum": ["guest_channel", "user_bound", "not_applicable"] },
          "context_policy": {
            "enum": ["none", "reference", "message", "conversation_summary", "lifecycle"]
          },
          "surface_policy": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["admin", "gpt_member", "gpt_guest"] }
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_owner", "requires"],
      "properties": {
        "probe_owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,100}$"
        },
        "requires": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["disk", "loader", "runtime"] }
        }
      }
    }
  }
}
