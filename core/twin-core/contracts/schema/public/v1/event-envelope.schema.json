{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/schema/twin/contracts/v1/event-envelope.schema.json",
  "title": "BizCity Twin Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "trace_id",
    "event_id",
    "event_type",
    "occurred_at",
    "producer",
    "tenant",
    "payload"
  ],
  "properties": {
    "contract": { "const": "event-envelope" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "trace_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "event_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "event_type": { "type": "string", "minLength": 3, "maxLength": 120 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 200 },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "version"],
      "properties": {
        "module": { "type": "string", "minLength": 3, "maxLength": 120 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" }
      }
    },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id", "blog_id"],
      "properties": {
        "site_id": { "type": "integer", "minimum": 1 },
        "blog_id": { "type": "integer", "minimum": 1 },
        "user_id": { "type": "integer", "minimum": 0 },
        "scope": { "enum": ["tenant", "site", "user"] }
      }
    },
    "payload": { "type": "object" },
    "meta": { "type": "object" }
  }
}
