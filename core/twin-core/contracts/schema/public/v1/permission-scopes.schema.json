{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/schema/twin/contracts/v1/permission-scopes.schema.json",
  "title": "BizCity Twin Permission Scope Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "requested"],
  "properties": {
    "contract": { "const": "permission-scopes" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "requested": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "scope_level", "reason"],
        "properties": {
          "scope": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$" },
          "scope_level": { "enum": ["tenant", "site", "user"] },
          "reason": { "type": "string", "minLength": 3, "maxLength": 200 },
          "effect": { "enum": ["allow", "deny"] }
        }
      }
    },
    "approval_required": { "type": "boolean" },
    "approved": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$" },
      "uniqueItems": true
    },
    "denied": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$" },
      "uniqueItems": true
    }
  }
}
