{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/schema/twin/contracts/v1/team-ops-board.schema.json",
  "title": "BizCity CRM Team Ops Board",
  "description": "PHASE-0.56 A-2: leader view of the team ops board (B2 `/crm/#/team`). Aggregated counters and rollup values only — never message bodies, never a customer phone/name. `staff-bot-link.schema.json` is the separate per-link contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "range", "as_of", "thresholds", "kpi", "attention", "staff", "coverage"],
  "properties": {
    "contract": { "const": "team-ops-board" },
    "version": { "const": "1.0.0" },
    "range": { "enum": ["today", "7d", "30d"] },
    "team_id": { "type": ["integer", "null"], "minimum": 1 },
    "as_of": { "type": "string", "format": "date-time" },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["breach_wait_minutes", "low_sample_min"],
      "properties": {
        "breach_wait_minutes": { "type": "integer", "minimum": 1 },
        "low_sample_min": { "type": "integer", "minimum": 1 }
      }
    },
    "kpi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["online", "total", "dead_phones", "breach", "revenue_paid", "no_channel"],
      "properties": {
        "online": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "dead_phones": { "type": "integer", "minimum": 0 },
        "breach": { "type": "integer", "minimum": 0 },
        "frt_median_s": { "type": ["integer", "null"], "minimum": 0 },
        "conv_to_order": { "$ref": "#/$defs/ratio" },
        "revenue_paid": { "type": "number", "minimum": 0 },
        "no_channel": { "type": "integer", "minimum": 0 },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "value", "count"],
            "properties": {
              "key": { "type": "string", "pattern": "^pipeline_[a-z0-9_]{2,63}$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 120 },
              "value": { "type": "number", "minimum": 0 },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "attention": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["dead_session", "duplicate_phone", "breach", "silent", "no_phone", "no_bot", "pending_qr"] },
          "user_id": { "type": "integer", "minimum": 1 },
          "inbox_id": { "type": "integer", "minimum": 1 },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "staff": {
      "type": "array",
      "items": { "$ref": "#/$defs/staffRow" }
    },
    "onboarding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "next"],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "done"],
            "properties": {
              "key": { "enum": ["plan", "team", "staff", "phone", "bot", "invite", "task"] },
              "done": { "type": "boolean" },
              "count": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "next": { "type": ["string", "null"], "enum": ["plan", "team", "staff", "phone", "bot", "invite", "task", null] }
      }
    },
    "insights": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value", "action"],
        "properties": {
          "kind": { "enum": ["load_skew", "dead_channel", "slow_first_reply"] },
          "user_id": { "type": "integer", "minimum": 1 },
          "inbox_id": { "type": "integer", "minimum": 1 },
          "value": { "type": "string", "minLength": 1, "maxLength": 300 },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "target_id"],
            "properties": {
              "kind": { "enum": ["open_handoff", "qr", "open_profile"] },
              "target_id": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["degraded_sources"],
      "properties": {
        "degraded_sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" } }
      }
    }
  },
  "$defs": {
    "ratio": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": { "type": "integer", "minimum": 0 },
        "den": { "type": "integer", "minimum": 0 }
      }
    },
    "phone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inbox_id", "display_phone", "state"],
      "properties": {
        "inbox_id": { "type": "integer", "minimum": 1 },
        "display_phone": { "type": "string", "maxLength": 32 },
        "state": { "enum": ["connected", "dead_session", "duplicate", "pending_qr"] }
      }
    },
    "staffRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "name", "role_label", "online", "phones", "zalo_bot", "open", "breach", "paid_orders", "revenue", "spark_7d", "can"],
      "properties": {
        "user_id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role_label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "team_id": { "type": ["integer", "null"], "minimum": 1 },
        "online": { "type": "boolean" },
        "silent_min": { "type": ["integer", "null"], "minimum": 0 },
        "phones": { "type": "array", "items": { "$ref": "#/$defs/phone" } },
        "zalo_bot": { "enum": ["linked", "none", null] },
        "open": { "type": "integer", "minimum": 0 },
        "breach": { "type": "integer", "minimum": 0 },
        "reply_rate": { "$ref": "#/$defs/ratio" },
        "frt_median_s": { "type": ["integer", "null"], "minimum": 0 },
        "conv_to_order": { "$ref": "#/$defs/ratio" },
        "paid_orders": { "type": "integer", "minimum": 0 },
        "revenue": { "type": "number", "minimum": 0 },
        "spark_7d": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "type": "integer", "minimum": 0 } },
        "can": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["add_phone", "qr", "link_bot", "move_team", "transfer_phone", "role", "suspend"] }
        }
      }
    }
  }
}
