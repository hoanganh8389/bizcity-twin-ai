{
  "contract": "extension-manifest",
  "version": "1.0.0",
  "extension_id": "vendor.tiktok",
  "extension_version": "1.0.0",
  "requires_framework": ">=1.3 <2.0",
  "capabilities": [
    "channel.inbound",
    "context.admit"
  ],
  "channels": [
    {
      "slug": "tiktok",
      "platform": "TIKTOK",
      "zone": "customer",
      "identity_policy": "account_video_comment",
      "account_scope": "multiple",
      "crm_policy": "enabled",
      "brain_policy": "guest_channel",
      "context_policy": "conversation_summary",
      "surface_policy": ["admin", "gpt_member"]
    }
  ],
  "diagnostics": {
    "probe_owner": "vendor.tiktok.contract",
    "requires": ["disk", "loader", "runtime"]
  }
}
