{
  "contract": "runtime-execution-policy",
  "version": "1.0.0",
  "idempotency": {
    "required": true,
    "key_ttl_seconds": 0,
    "header": "x-idempotency-key"
  },
  "retry_policy": {
    "transient": { "max_attempts": -1, "initial_backoff_ms": 200, "max_backoff_ms": 3000 },
    "rate_limited": { "max_attempts": 5, "initial_backoff_ms": 500, "max_backoff_ms": 60000 },
    "timeout": { "max_attempts": 2, "initial_backoff_ms": 300, "max_backoff_ms": 4000 },
    "permanent": { "max_attempts": 0, "initial_backoff_ms": 0, "max_backoff_ms": 0 }
  },
  "dead_letter": {
    "enabled": true,
    "queue_name": "bizcity_dlx",
    "max_age_seconds": 30
  },
  "concurrency": {
    "lock_scope": "resource",
    "lock_ttl_seconds": 0,
    "max_inflight": 0
  },
  "circuit_breaker": {
    "failure_threshold": 0,
    "recovery_timeout_seconds": 0,
    "half_open_max_calls": 0
  },
  "backpressure": {
    "queue_limit": 0,
    "drop_policy": "none",
    "quota_per_minute": 0
  },
  "timeout_budget": {
    "default_ms": 0,
    "provider_ms": 0,
    "channel_ms": 0
  },
  "trace": {
    "propagate_headers": []
  },
  "slo": {
    "success_rate_target": 2,
    "p95_latency_ms": 0,
    "citation_coverage_target": -1,
    "tool_error_rate_max": 2
  }
}
