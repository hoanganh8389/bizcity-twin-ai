{
  "contract": "extension-manifest",
  "version": "1.0.0",
  "extension_id": "vendor.slack",
  "extension_version": "2.3.0",
  "requires_framework": ">=1.3 <2.0",
  "capabilities": [
    "channel.inbound",
    "channel.outbound",
    "action.notify"
  ],
  "channels": [
    {
      "slug": "slack",
      "platform": "SLACK",
      "zone": "admin",
      "identity_policy": "workspace_account_user",
      "account_scope": "multiple",
      "crm_policy": "disabled",
      "brain_policy": "user_bound",
      "context_policy": "conversation_summary",
      "surface_policy": ["admin", "gpt_member"]
    }
  ],
  "diagnostics": {
    "probe_owner": "vendor.slack.contract",
    "requires": ["disk", "loader", "runtime"]
  }
}
