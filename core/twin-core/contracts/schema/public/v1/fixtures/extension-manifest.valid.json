{
  "contract": "extension-manifest",
  "version": "1.0.0",
  "extension_id": "bizcity.zalo-bot",
  "extension_version": "1.0.0",
  "requires_framework": ">=1.3 <2.0",
  "capabilities": [
    "channel.inbound",
    "channel.outbound",
    "context.admit"
  ],
  "setting_panel": [
    {
      "contract": "setting-panel-registration",
      "version": "1.0.0",
      "id": "extension.shopee.settings",
      "owner": "extension/vendor.shopee",
      "origin": "extension",
      "destination": "control-panel",
      "group": "commerce",
      "label_key": "shopee.settings.label",
      "icon": "cil-puzzle",
      "capability": "manage_options",
      "scope": "site",
      "surface": "admin_page",
      "renderer": { "type": "deep_link", "id": "extension.shopee.settings", "canonical_slug": "shopee-settings" },
      "availability": { "policy": "registered-owner", "dependency_ids": ["extension.vendor.shopee"] },
      "position": 500
    }
  ],
  "channels": [
    {
      "slug": "zalo_bot",
      "platform": "ZALO_BOT",
      "zone": "admin",
      "identity_policy": "bot_user_or_group",
      "account_scope": "multiple",
      "crm_policy": "enabled",
      "brain_policy": "user_bound",
      "context_policy": "conversation_summary",
      "surface_policy": ["admin", "gpt_member"]
    }
  ],
  "diagnostics": {
    "probe_owner": "core.channel.zalo_bot.contract",
    "requires": ["disk", "loader", "runtime"]
  }
}
