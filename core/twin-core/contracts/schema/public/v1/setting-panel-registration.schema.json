{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/schema/setting-panel-registration-v1.json",
  "title": "BizCity Twin Setting Panel Registration Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "items"],
  "properties": {
    "contract": { "const": "setting-panel-registration" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract", "version", "id", "owner", "origin", "destination",
        "group", "label_key", "icon", "capability", "scope", "surface",
        "renderer", "availability", "position"
      ],
      "properties": {
        "contract": { "const": "setting-panel-registration" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" },
        "owner": { "type": "string", "minLength": 2, "maxLength": 160 },
        "origin": { "enum": ["core", "module", "bundle", "extension", "legacy_adapter"] },
        "destination": {
          "enum": ["workspace", "settings", "control-panel", "channel-settings", "crm-inbox", "plugins-store"]
        },
        "group": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,80}$" },
        "label_key": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,160}$" },
        "description_key": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,160}$" },
        "icon": { "type": "string", "pattern": "^cil-[a-z0-9-]+$" },
        "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){0,4}$" },
        "scope": { "enum": ["site", "network", "user", "site_user"] },
        "surface": { "enum": ["admin_shell", "admin_page", "network_admin", "external"] },
        "renderer": { "$ref": "#/$defs/renderer" },
        "availability": { "$ref": "#/$defs/availability" },
        "position": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9 _.-]{0,63}$" }
        },
        "badge": { "enum": ["new", "beta", "pro", "update", "deprecated"] },
        "zone": { "enum": ["customer", "admin", "system"] },
        "plan": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" },
        "required": { "type": "boolean" },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9._/-]{2,160}$" }
        },
        "diagnostics": { "$ref": "#/$defs/diagnostics" },
        "docs_url": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?:/[^\\s]*)?$" },
        "order_lock": { "enum": ["none", "system_first", "system_last"] },
        "native_contract": { "type": "boolean" },
        "migration_owner": { "type": "string", "minLength": 2, "maxLength": 160 },
        "sunset_after": { "type": "string", "pattern": "^[A-Z0-9._-]{2,80}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "destination": { "const": "channel-settings" } } },
          "then": { "required": ["zone"] }
        },
        {
          "if": { "properties": { "origin": { "const": "legacy_adapter" } } },
          "then": { "required": ["native_contract", "migration_owner", "sunset_after"] }
        }
      ]
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["coreui", "route", "embed", "deep_link", "external"] },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" },
        "canonical_slug": { "type": "string", "pattern": "^[a-z][a-z0-9._/-]{2,160}$" },
        "route": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]*$" },
        "target_url": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?:/[^\\s]*)?$" },
        "allowed_query_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }
        },
        "shell_mode": { "enum": ["detail", "full", "external"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["coreui", "route"] } } },
          "then": { "required": ["route"] }
        },
        {
          "if": { "properties": { "type": { "const": "deep_link" } } },
          "then": { "required": ["canonical_slug"] }
        },
        {
          "if": { "properties": { "type": { "const": "external" } } },
          "then": { "required": ["target_url"], "properties": { "shell_mode": { "const": "external" } } }
        }
      ]
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": { "enum": ["registered-owner", "all", "any", "always"] },
        "dependency_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,100}$" }
        },
        "min_framework": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "min_php": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "min_wp": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_id", "help_code"],
      "properties": {
        "probe_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,120}$" },
        "help_code": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,120}$" }
      }
    }
  }
}
