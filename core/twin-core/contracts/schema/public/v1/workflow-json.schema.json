{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/schema/twin/contracts/v1/workflow-json.schema.json",
  "title": "BizCity Twin Workflow JSON Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "workflow"],
  "properties": {
    "contract": { "const": "workflow-json" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "name", "schema_version", "trigger", "nodes", "edges"],
      "properties": {
        "workflow_id": { "type": "string", "minLength": 8, "maxLength": 120 },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "trigger": { "type": "object" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "data"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 80 },
              "type": { "type": "string", "minLength": 1, "maxLength": 80 },
              "data": { "type": "object" },
              "permissions": {
                "type": "array",
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$" },
                "uniqueItems": true
              },
              "retry_policy": { "type": "object" },
              "timeout_ms": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source", "target"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 80 },
              "source": { "type": "string", "minLength": 1, "maxLength": 80 },
              "target": { "type": "string", "minLength": 1, "maxLength": 80 },
              "source_handle": { "type": "string", "maxLength": 80 }
            }
          }
        }
      }
    }
  }
}
