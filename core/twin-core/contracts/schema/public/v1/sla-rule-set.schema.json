{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/schema/twin/contracts/v1/sla-rule-set.schema.json",
  "title": "BizCity SLA Rule Set",
  "description": "PHASE-0.63 D63-10 — shared SLA rule vocabulary for conversation applied_slas and pipeline deadlines.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "rules"],
  "properties": {
    "contract": { "const": "sla-rule-set" },
    "version": { "const": "1.0.0" },
    "clock": { "type": "string", "pattern": "^(24x7|calendar:[a-z][a-z0-9_]{0,63})$" },
    "pause_when": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "condition": { "type": "string", "pattern": "^[a-z_]+\\([^()]*\\)$", "maxLength": 190 },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "anchor", "offset", "target"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "layer": { "enum": ["step", "wait", "process", "exception"] },
        "anchor": { "type": "string", "pattern": "^(run_created|assigned|accepted|last_inbound|appointment_at|checkin|exception_raised(\\([A-Za-z0-9._-]{1,64}\\))?|stage_ready\\([A-Za-z0-9._-]{1,64}\\)|stage_started\\([A-Za-z0-9._-]{1,64}\\)|field:[a-z][a-z0-9_]{0,63})$" },
        "offset": { "type": "string", "pattern": "^[+-]?[0-9]{1,5}(m|h|d|w)$" },
        "target": { "type": "string", "pattern": "^(assigned|accepted|first_outbound|run_terminal|exception_ack|exception_resolved|checkin|stage_started\\([A-Za-z0-9._-]{1,64}\\)|stage_done\\([A-Za-z0-9._-]{1,64}\\)|stage_in\\(\\[[A-Za-z0-9._,\\s-]{1,190}\\]\\))$" },
        "on_miss": { "type": "array", "items": { "$ref": "#/$defs/rung" } }
      }
    },
    "rung": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "do"],
      "properties": {
        "at": { "type": "string", "pattern": "^(0|[+-][0-9]{1,3}%|[+-][0-9]{1,5}(m|h|d))$" },
        "do": { "type": "string", "pattern": "^[a-z_]+\\([^()]*\\)(\\s*\\+\\s*[a-z_]+\\([^()]*\\))*$", "maxLength": 190 }
      }
    }
  }
}
