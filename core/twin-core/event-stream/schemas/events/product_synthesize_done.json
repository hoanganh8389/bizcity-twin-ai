{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bizcity://events/product_synthesize_done.json",
  "title": "product_synthesize_done",
  "description": "Emitted when products synthesis completes and final answer context is ready. PHASE-TWB-PRODUCTS (2026-07-15).",
