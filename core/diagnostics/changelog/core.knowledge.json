{
  "$schema": "https://bizcity.vn/schema/diagnostics-changelog-v1.json",
  "module_id": "core.knowledge",
  "owner": "core/knowledge",
  "installer_id": "bizcity_knowledge",
  "current_version": "3.25.0",
  "version_option": "bizcity_knowledge_db_version",
  "tables": {
    "bizcity_characters": {
      "since": "3.0.0",
      "purpose": "Canonical Twin Guru character records and policy metadata owned by the core knowledge database installer.",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id": { "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT", "since": "3.0.0", "pk": true },
        "name": { "type": "VARCHAR(255) NOT NULL", "since": "3.0.0" },
        "slug": { "type": "VARCHAR(255) NOT NULL", "since": "3.0.0" },
        "avatar": { "type": "VARCHAR(500) DEFAULT ''", "since": "3.0.0" },
        "description": { "type": "TEXT", "since": "3.0.0" },
        "system_prompt": { "type": "TEXT", "since": "3.0.0" },
        "model_id": { "type": "VARCHAR(255) DEFAULT ''", "since": "3.0.0" },
        "creativity_level": { "type": "DECIMAL(3,2) DEFAULT 0.70", "since": "3.0.0" },
        "max_tokens": { "type": "INT UNSIGNED NULL DEFAULT NULL", "since": "3.0.3" },
        "greeting_messages": { "type": "TEXT", "since": "3.0.0" },
        "capabilities": { "type": "TEXT", "since": "3.0.0" },
        "industries": { "type": "TEXT", "since": "3.0.0" },
        "variables_schema": { "type": "TEXT", "since": "3.0.0" },
        "settings": { "type": "TEXT", "since": "3.0.0" },
        "allowed_verticals": { "type": "LONGTEXT NULL", "since": "3.23.0" },
        "notebook_policy": { "type": "ENUM('augment','restrict') NOT NULL DEFAULT 'augment'", "since": "3.24.0" },
        "min_role": { "type": "VARCHAR(32) NOT NULL DEFAULT ''", "since": "3.25.0" },
        "min_plan": { "type": "VARCHAR(32) NOT NULL DEFAULT ''", "since": "3.25.0" },
        "guru_uuid": { "type": "CHAR(36) DEFAULT NULL", "since": "3.21.0" },
        "visibility": { "type": "VARCHAR(16) NOT NULL DEFAULT 'private'", "since": "3.21.0" },
        "version": { "type": "VARCHAR(20) NOT NULL DEFAULT '1.0.0'", "since": "3.21.0" },
        "license": { "type": "VARCHAR(20) NOT NULL DEFAULT 'proprietary'", "since": "3.21.0" },
        "manifest_hash": { "type": "CHAR(64) DEFAULT NULL", "since": "3.21.0" },
        "bin_path": { "type": "VARCHAR(255) DEFAULT NULL", "since": "3.21.0" },
        "bin_dim": { "type": "INT UNSIGNED DEFAULT NULL", "since": "3.21.0" },
        "bin_count": { "type": "INT UNSIGNED DEFAULT NULL", "since": "3.21.0" },
        "embed_model": { "type": "VARCHAR(64) DEFAULT NULL", "since": "3.21.0" },
        "origin_user": { "type": "BIGINT UNSIGNED DEFAULT NULL", "since": "3.21.0" },
        "published_at": { "type": "DATETIME DEFAULT NULL", "since": "3.21.0" },
        "status": { "type": "ENUM('draft','active','published','archived') DEFAULT 'draft'", "since": "3.0.0" },
        "author_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "3.0.0" },
        "market_id": { "type": "BIGINT UNSIGNED DEFAULT NULL", "since": "3.0.0" },
        "total_conversations": { "type": "BIGINT UNSIGNED DEFAULT 0", "since": "3.0.0" },
        "total_messages": { "type": "BIGINT UNSIGNED DEFAULT 0", "since": "3.0.0" },
        "rating": { "type": "DECIMAL(3,2) DEFAULT 0.00", "since": "3.0.0" },
        "owner_type": { "type": "VARCHAR(20) DEFAULT 'standalone'", "since": "3.0.0" },
        "owner_id": { "type": "VARCHAR(50) DEFAULT ''", "since": "3.0.0" },
        "created_at": { "type": "DATETIME DEFAULT CURRENT_TIMESTAMP", "since": "3.0.0" },
        "updated_at": { "type": "DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP", "since": "3.0.0" }
      },
      "indexes": {
        "slug": { "cols": ["slug"], "unique": true, "since": "3.0.0" },
        "author_id": { "cols": ["author_id"], "since": "3.0.0" },
        "status": { "cols": ["status"], "since": "3.0.0" },
        "market_id": { "cols": ["market_id"], "since": "3.0.0" },
        "owner_type_id": { "cols": ["owner_type", "owner_id"], "since": "3.0.0" },
        "uq_guru_uuid": { "cols": ["guru_uuid"], "unique": false, "since": "3.21.0" },
        "idx_visibility": { "cols": ["visibility"], "since": "3.21.0" }
      }
    }
  },
  "history": [
    { "version": "3.25.0", "date": "2026-08-15", "change": "PHASE-TWB-GURU-AUDIENCE: add per-Guru min_role and min_plan audience requirements used by the shared policy gateway." },
    { "version": "3.24.0", "date": "2026-08-15", "change": "PHASE-TWB-GURU-NOTEBOOK: add bizcity_characters.notebook_policy with augment/restrict semantics; attachment registry is the canonical Quick-Edit write path." },
    { "version": "3.23.0", "date": "2026-08-14", "change": "PHASE-TWB-GURU-POLICY: declare bizcity_characters.allowed_verticals as the canonical JSON allowlist storage for sensitive Guru vertical capabilities." },
    { "version": "3.22.0", "date": "2026-07-28", "change": "PHASE-0.52 W8.2: durable identity UUID ownership on bizcity_memory_users." },
    { "version": "3.21.0", "date": "2026-05-06", "change": "PHASE-0.21: declare Guru marketplace metadata columns on bizcity_characters." },
    { "version": "3.0.3", "date": "2026-04-01", "change": "Knowledge database baseline with max_tokens character migration." },
    { "version": "3.0.0", "date": "2026-04-01", "change": "Initial declaration of the core knowledge character table." }
  ]
}
