{
  "$schema": "https://bizcity.vn/schema/diagnostics-changelog-v1.json",
  "module_id": "core.context-bank",
  "owner": "core/context-bank",
  "installer_id": "context_bank",
  "current_version": "1.3.0",
  "version_option": "bizcity_context_bank_schema_version",
  "tables": {
    "bizcity_context_bank": {
      "since": "1.0.0",
      "purpose": "Tenant-scoped rebuildable Context Bank pointer/correlation ledger. It stores verified file metadata and provenance only; canonical payload remains in the registered business filestore or Event Stream owner.",
      "note": "Never store memory, message, document, rule, decrypted content, embedding, credential, raw secret or copied JSON payload in this table.",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id": { "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT", "since": "1.0.0", "pk": true },
        "blog_id": { "type": "BIGINT UNSIGNED NOT NULL", "since": "1.0.0" },
        "site_id": { "type": "BIGINT UNSIGNED NOT NULL", "since": "1.0.0" },
        "record_id": { "type": "VARCHAR(191) NOT NULL", "since": "1.0.0" },
        "event_uuid": { "type": "VARCHAR(128) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "source_contract_id": { "type": "VARCHAR(191) NOT NULL", "since": "1.0.0" },
        "contract_version": { "type": "VARCHAR(32) NOT NULL DEFAULT '1.0.0'", "since": "1.1.0" },
        "schema_version": { "type": "VARCHAR(32) NOT NULL DEFAULT '1.0.0'", "since": "1.0.0" },
        "record_kind": { "type": "VARCHAR(24) NOT NULL", "since": "1.0.0" },
        "parent_record_id": { "type": "VARCHAR(191) NOT NULL DEFAULT ''", "since": "1.1.0" },
        "root_record_id": { "type": "VARCHAR(191) NOT NULL DEFAULT ''", "since": "1.1.0" },
        "identity_uuid": { "type": "VARCHAR(191) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "wp_user_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.0.0" },
        "contact_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.0.0" },
        "conversation_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.0.0" },
        "entity_type": { "type": "VARCHAR(80) NOT NULL DEFAULT ''", "since": "1.1.0" },
        "entity_key": { "type": "VARCHAR(191) NOT NULL DEFAULT ''", "since": "1.1.0" },
        "secondary_type": { "type": "VARCHAR(80) NOT NULL DEFAULT ''", "since": "1.1.0" },
        "secondary_key": { "type": "VARCHAR(191) NOT NULL DEFAULT ''", "since": "1.1.0" },
        "scope_key": { "type": "VARCHAR(191) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "case_id": { "type": "VARCHAR(191) NOT NULL DEFAULT ''", "since": "1.1.0" },
        "goal_id": { "type": "VARCHAR(191) NOT NULL DEFAULT ''", "since": "1.1.0" },
        "notebook_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.1.0" },
        "source_record_id": { "type": "VARCHAR(191) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "trace_id": { "type": "VARCHAR(128) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "occurred_at": { "type": "DATETIME NOT NULL", "since": "1.0.0" },
        "ingested_at": { "type": "DATETIME NOT NULL", "since": "1.0.0" },
        "valid_from": { "type": "DATETIME NULL", "since": "1.1.0" },
        "valid_to": { "type": "DATETIME NULL", "since": "1.1.0" },
        "rollup_window": { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.1.0" },
        "rollup_version": { "type": "VARCHAR(32) NOT NULL DEFAULT ''", "since": "1.1.0" },
        "relative_file": { "type": "VARCHAR(500) NOT NULL", "since": "1.0.0" },
        "byte_offset": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.0.0" },
        "row_hash": { "type": "CHAR(64) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "content_hash": { "type": "CHAR(64) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "operation": { "type": "VARCHAR(16) NOT NULL DEFAULT 'upsert'", "since": "1.0.0" },
        "lifecycle_status": { "type": "VARCHAR(24) NOT NULL DEFAULT 'active'", "since": "1.0.0" },
        "kg_status": { "type": "VARCHAR(24) NOT NULL DEFAULT 'not_candidate'", "since": "1.0.0" },
        "kg_source_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.1.0" },
        "kg_passage_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.1.0" },
        "provenance_ref": { "type": "VARCHAR(191) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "idempotency_key": { "type": "VARCHAR(200) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "indexed_at": { "type": "DATETIME NULL", "since": "1.1.0" },
        "created_at": { "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP", "since": "1.0.0" },
        "updated_at": { "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP", "since": "1.0.0" }
      },
      "indexes": {
        "uq_context_record": { "cols": ["blog_id", "source_contract_id", "record_id"], "since": "1.0.0", "unique": true },
        "idx_identity_scope": { "cols": ["blog_id", "identity_uuid", "scope_key", "updated_at"], "since": "1.0.0" },
        "idx_entity_scope": { "cols": ["blog_id", "entity_type", "entity_key", "updated_at"], "since": "1.1.0" },
        "idx_event_time": { "cols": ["blog_id", "occurred_at", "record_kind"], "since": "1.0.0" },
        "idx_source_pointer": { "cols": ["source_contract_id", "relative_file", "byte_offset"], "since": "1.0.0" },
        "idx_status_kg": { "cols": ["blog_id", "lifecycle_status", "kg_status", "updated_at"], "since": "1.0.0" },
        "idx_trace": { "cols": ["blog_id", "trace_id"], "since": "1.0.0" }
      }
    },
    "bizcity_context_bank_rollup_state": {
      "since": "1.2.0",
      "purpose": "Tenant-scoped rollup worker lease and checkpoint state. It stores resumable processing metadata only; rollup payload remains in the registered encrypted business filestore.",
      "note": "No source payload, message body, credential or provider secret may be stored here. A checkpoint advances only after the rollup receipt and Context Bank pointer succeed.",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id": { "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT", "since": "1.2.0", "pk": true },
        "blog_id": { "type": "BIGINT UNSIGNED NOT NULL", "since": "1.2.0" },
        "rollup_id": { "type": "VARCHAR(80) NOT NULL", "since": "1.2.0" },
        "dimension_key": { "type": "VARCHAR(191) NOT NULL", "since": "1.2.0" },
        "lock_token": { "type": "CHAR(64) NOT NULL DEFAULT ''", "since": "1.2.0" },
        "lock_expires_at": { "type": "DATETIME NULL", "since": "1.2.0" },
        "checkpoint_record_id": { "type": "VARCHAR(191) NOT NULL DEFAULT ''", "since": "1.2.0" },
        "checkpoint_occurred_at": { "type": "DATETIME NULL", "since": "1.2.0" },
        "processed_count": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.2.0" },
        "last_output_hash": { "type": "CHAR(64) NOT NULL DEFAULT ''", "since": "1.2.0" },
        "last_error": { "type": "VARCHAR(80) NOT NULL DEFAULT ''", "since": "1.2.0" },
        "dirty_since": { "type": "DATETIME NULL", "since": "1.3.0" },
        "dirty_record_id": { "type": "VARCHAR(191) NOT NULL DEFAULT ''", "since": "1.3.0" },
        "superseded_record_id": { "type": "VARCHAR(191) NOT NULL DEFAULT ''", "since": "1.3.0" },
        "created_at": { "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP", "since": "1.2.0" },
        "updated_at": { "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP", "since": "1.2.0" }
      },
      "indexes": {
        "uq_rollup_dimension": { "cols": ["blog_id", "rollup_id", "dimension_key"], "since": "1.2.0", "unique": true },
        "idx_rollup_lock": { "cols": ["blog_id", "rollup_id", "lock_expires_at"], "since": "1.2.0" },
        "idx_rollup_checkpoint": { "cols": ["blog_id", "rollup_id", "checkpoint_occurred_at"], "since": "1.2.0" }
      }
    }
  },
  "history": [
    {
      "version": "1.3.0",
      "date": "2026-09-02",
      "change": "CB5.1 — add tenant-scoped dirty and supersession metadata so late source events reopen a bounded rollup window without storing payload."
    },
    {
      "version": "1.2.0",
      "date": "2026-09-02",
      "change": "CB5.1 — add tenant-scoped rollup worker lease/checkpoint state. State contains resumable metadata only; rollup payload remains in the encrypted business filestore and pointer ledger."
    },
    {
      "version": "1.1.0",
      "date": "2026-09-01",
      "change": "CB3.1 — add contract version, parent/root causality, entity/case/goal/notebook dimensions, validity and rollup metadata, KG source/passage references and indexed timestamp. Pointer-only fields; no payload body added."
    },
    {
      "version": "1.0.0",
      "date": "2026-09-01",
      "change": "CB3 — add tenant-scoped pointer/correlation ledger for Context Bank. Payload remains in canonical encrypted business filestore or Event Stream; ledger stores verified receipt metadata, identity dimensions, provenance and lifecycle status only. Requires Schema Registry, Site Provisioner and physical-shard DDV before runtime enablement."
    }
  ]
}
