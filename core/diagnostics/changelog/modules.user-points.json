{
  "$schema": "https://bizcity.vn/schema/diagnostics-changelog-v1.json",
  "module_id": "modules.user-points",
  "owner": "plugins/user-points",
  "installer_id": "user_points",
  "current_version": "1.1.0",
  "version_option": "user_points_schema_version",
  "tables": {
    "user_points": {
      "since": "1.0.0",
      "description": "Legacy points credit ledger owned by the user-points plugin.",
      "columns": {
        "id":               { "type": "MEDIUMINT NOT NULL AUTO_INCREMENT", "since": "1.0.0", "pk": true },
        "code":             { "type": "VARCHAR(255) NOT NULL",             "since": "1.0.0" },
        "store_name":       { "type": "VARCHAR(255) NOT NULL",             "since": "1.0.0" },
        "product":          { "type": "VARCHAR(255) NOT NULL",             "since": "1.0.0" },
        "phone":            { "type": "VARCHAR(255) NOT NULL",             "since": "1.0.0" },
        "client_id":        { "type": "VARCHAR(255) NULL",                 "since": "1.0.0" },
        "user_points":      { "type": "VARCHAR(255) NULL",                 "since": "1.0.0" },
        "time":             { "type": "DATETIME NOT NULL",                 "since": "1.0.0" },
        "contact_id":       { "type": "BIGINT UNSIGNED NULL",              "since": "1.1.0", "comment": "Canonical bizcity_crm_contacts.id link; additive identity projection." }
      },
      "indexes": {
        "PRIMARY":     { "cols": ["id"],          "since": "1.0.0" },
        "idx_contact": { "cols": ["contact_id"],  "since": "1.1.0" },
        "idx_phone":   { "cols": ["phone"],       "since": "1.0.0" }
      }
    },
    "user_points_exchange": {
      "since": "1.0.0",
      "description": "Legacy points debit/redemption ledger owned by the user-points plugin.",
      "columns": {
        "id":               { "type": "MEDIUMINT NOT NULL AUTO_INCREMENT", "since": "1.0.0", "pk": true },
        "phone":            { "type": "VARCHAR(255) NOT NULL",             "since": "1.0.0" },
        "product":          { "type": "VARCHAR(255) NOT NULL",             "since": "1.0.0" },
        "points":           { "type": "INT NOT NULL",                      "since": "1.0.0" },
        "remaining_points": { "type": "INT NOT NULL",                      "since": "1.0.0" },
        "time":             { "type": "DATETIME NOT NULL",                 "since": "1.0.0" },
        "contact_id":       { "type": "BIGINT UNSIGNED NULL",              "since": "1.1.0", "comment": "Canonical bizcity_crm_contacts.id link; additive identity projection." }
      },
      "indexes": {
        "PRIMARY":     { "cols": ["id"],          "since": "1.0.0" },
        "idx_contact": { "cols": ["contact_id"],  "since": "1.1.0" },
        "idx_phone":   { "cols": ["phone"],       "since": "1.0.0" }
      }
    }
  },
  "history": [
    {
      "version": "1.0.0",
      "date": "2026-08-11",
      "change": "Baseline inventory of legacy user-points credit and debit ledgers; tables remain owned by plugins/user-points."
    },
    {
      "version": "1.1.0",
      "date": "2026-08-11",
      "change": "Additive contact_id projection columns and indexes for CRM Contacts identity linkage; points arithmetic remains phone-ledger based."
    }
  ]
}
