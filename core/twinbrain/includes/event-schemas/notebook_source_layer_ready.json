{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "notebook_source_layer_ready",
  "description": "TwinBrain Notebook Source Layer — first-class source map for Ask Brain notebook answers.",
  "type": "object",
  "required": ["trace_id", "notebook_count", "passage_count", "notebook_source_map", "notebook_source_block_md"],
  "properties": {
    "trace_id": { "type": "string" },
    "notebook_count": { "type": "integer", "minimum": 0 },
    "passage_count": { "type": "integer", "minimum": 0 },
    "strong_count": { "type": "integer", "minimum": 0 },
    "weak_count": { "type": "integer", "minimum": 0 },
    "source_file_count": { "type": "integer", "minimum": 0 },
    "source_file_with_relations_count": { "type": "integer", "minimum": 0 },
    "search_context_total": { "type": "integer", "minimum": 0 },
    "search_context_top_n": { "type": "integer", "minimum": 0 },
    "search_context_query": { "type": "string" },
    "search_context_scope": { "type": "string" },
    "search_context_tokens": { "type": "array", "items": { "type": "string" } },
    "product_entity_count": { "type": "integer", "minimum": 0 },
    "product_name_entity_count": { "type": "integer", "minimum": 0 },
    "product_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source_title", "citation", "evidence_excerpt", "confidence"],
        "properties": {
          "name": { "type": "string" },
          "normalized_name": { "type": "string" },
          "entity_type": { "type": "string", "enum": ["product_name", "category_trait", "claim_phrase"] },
          "is_product_name": { "type": "boolean" },
          "source_title": { "type": "string" },
          "notebook_title": { "type": "string" },
          "source_id": { "type": "integer" },
          "passage_id": { "type": "integer" },
          "citation": { "type": "string" },
          "evidence_excerpt": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "match_reason": { "type": "string" }
        }
      }
    },
    "search_context_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rank": { "type": "integer", "minimum": 0 },
          "notebook_id": { "type": "integer" },
          "notebook_title": { "type": "string" },
          "source_id": { "type": "integer" },
          "source_title": { "type": "string" },
          "origin_kind": { "type": "string" },
          "origin_url": { "type": "string" },
          "first_passage_id": { "type": "integer" },
          "citation": { "type": "string" },
          "match_count": { "type": "integer", "minimum": 0 },
          "document_chars": { "type": "integer", "minimum": 0 },
          "snippet": { "type": "string" },
          "context_excerpt": { "type": "string" },
          "matched_tokens": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "notebook_source_block_md": { "type": "string" },
    "context_bank": {
      "type": "object",
      "description": "Bounded Context Bank Brain metadata for MPR timeline surfaces; excludes ledger rows and owner bodies. Contract CONTEXT-BANK-ASYNC-TIMELINE-CONTRACT-v1 §2.2 (v2 additive: all v1 fields keep their meaning).",
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "type": "string" },
        "source_ref_count": { "type": "integer", "minimum": 0 },
        "pointer_follows": { "type": "integer", "minimum": 0 },
        "owner_excerpt_count": { "type": "integer", "minimum": 0 },
        "degraded": { "type": "boolean" },
        "incomplete": { "type": "boolean" },
        "reason": { "type": "string" },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Server-measured wall time of the Context Bank phase. Never the turn duration; a consumer must not substitute a live turn timer for this row."
        },
        "budget_ms": { "type": "integer", "minimum": 0, "description": "Declared bound for the phase from the scope resolver budgets." },
        "reason_bucket": {
          "type": "string",
          "description": "Stable machine bucket from the contract §4 registry. Empty string means normal completion. UI copy may translate it; logs and probes must match the token."
        },
        "status": {
          "type": "string",
          "enum": ["ran", "skipped", "degraded", "deadline"],
          "description": "Must agree with enabled: enabled=false implies status=skipped."
        },
        "matched_count": { "type": "integer", "minimum": 0, "description": "Ledger rows matched before verification." },
        "returned_count": { "type": "integer", "minimum": 0, "description": "Rows returned after verification." },
        "truncated": { "type": "boolean", "description": "The ledger page was truncated." },
        "vertical_id": { "type": "string", "description": "Server-derived vertical binding that applied; empty when none applied." },
        "binding_source": { "type": "string", "enum": ["web_mode", "slash_command", "none"] },
        "dimension_filters": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Filter field NAMES only (e.g. entity_type, date_from). Never the values, which may carry PII."
        },
        "contract_count": { "type": "integer", "minimum": 0, "description": "Contracts in the effective allowlist after narrowing." },
        "mode_hint_applied": { "type": "string", "enum": ["", "inherit", "hybrid", "skip"], "description": "The vertical binding's declared hint, distinct from mode (the resolver's effective mode). Present only when vertical_id applied." },
        "contracts_before_narrowing": { "type": "integer", "minimum": 0 },
        "contracts_after_narrowing": { "type": "integer", "minimum": 0, "description": "Must be <= contracts_before_narrowing; equality is valid only when the binding's contract list is a superset of the allowlist by design." },
        "rounds": { "type": "integer", "minimum": 1, "description": "How many bounded retrieve rounds reused this one phase result." },
        "admitted_count": { "type": "integer", "minimum": 0, "description": "PHASE-1.33D-D4 - Context Bank owner excerpts admitted into the W0.20 candidate pool. Count only; never an excerpt, id or title." },
        "final_count": { "type": "integer", "minimum": 0, "description": "PHASE-1.33D-D4 - how many of those admitted excerpts survived the canonical rerank into the final top5-8." },
        "zero_score_final_count": { "type": "integer", "minimum": 0, "description": "PHASE-1.33D-D4 - final chunks whose normalized score is still 0. A high value means the rerank did not discriminate; used to compare a bound-vertical turn against an unbound one." }
      }
    },
    "source_file_briefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["notebook_id", "source_id", "source_title", "coverage", "key_citations"],
        "properties": {
          "notebook_id": { "type": "integer" },
          "source_id": { "type": "integer" },
          "source_title": { "type": "string" },
          "source_type": { "type": "string" },
          "origin_url": { "type": "string" },
          "passage_count_total": { "type": "integer", "minimum": 0 },
          "passage_count_used": { "type": "integer", "minimum": 0 },
          "coverage": { "type": "string", "enum": ["strong", "partial", "weak"] },
          "key_citations": { "type": "array", "items": { "type": "string" } },
          "matched_tokens": { "type": "array", "items": { "type": "string" } },
          "search_context_hits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "token": { "type": "string" },
                "excerpt": { "type": "string" },
                "match_count": { "type": "integer", "minimum": 0 },
                "rank": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "relation_triples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["subject", "predicate", "object"],
              "properties": {
                "subject": { "type": "string" },
                "predicate": { "type": "string" },
                "object": { "type": "string" }
              }
            }
          },
          "source_claims": { "type": "array", "items": { "type": "string" } },
          "source_gaps": { "type": "array", "items": { "type": "string" } },
          "rank_reason": { "type": "string" }
        }
      }
    },
    "notebook_source_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["notebook_id", "title", "coverage", "passages"],
        "properties": {
          "notebook_id": { "type": "integer" },
          "title": { "type": "string" },
          "label": { "type": "string" },
          "selection_reason": { "type": "string" },
          "score": { "type": "number" },
          "guru_bound": { "type": "boolean" },
          "coverage": {
            "type": "object",
            "properties": {
              "passage_count": { "type": "integer", "minimum": 0 },
              "matched_token_count": { "type": "integer", "minimum": 0 },
              "search_context_count": { "type": "integer", "minimum": 0 },
              "source_files": { "type": "array", "items": { "type": "string" } },
              "confidence": { "type": "string", "enum": ["strong", "medium", "weak"] }
            }
          },
          "passages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["token", "passage_id"],
              "properties": {
                "token": { "type": "string" },
                "passage_id": { "type": "integer" },
                "source_id": { "type": "integer" },
                "source_title": { "type": "string" },
                "source_type": { "type": "string" },
                "matched_tokens": { "type": "array", "items": { "type": "string" } },
                "excerpt": { "type": "string" },
                "rank_reason": { "type": "string" },
                "search_match_count": { "type": "integer", "minimum": 0 },
                "search_result_rank": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}