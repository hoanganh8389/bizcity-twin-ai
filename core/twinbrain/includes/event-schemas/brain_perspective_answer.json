{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "brain_perspective_answer",
  "description": "TwinBrain Stage 2 — one notebook sub-agent answer.",
  "type": "object",
  "required": ["trace_id", "notebook_id", "stance", "confidence", "answer_md"],
  "properties": {
    "trace_id":    { "type": "string" },
    "notebook_id": { "type": "integer" },
    "label":       { "type": "string"  },
    "stance":      { "type": "string", "enum": ["yes", "no", "conditional", "unknown", "cancelled"] },
    "confidence":  { "type": "number", "minimum": 0, "maximum": 1 },
    "answer_md":   { "type": "string" },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "passage_id": { "type": "integer" },
          "source_id":  { "type": "integer" }
        }
      }
    },
    "tokens": { "type": "integer", "minimum": 0 },
    "ms":     { "type": "integer", "minimum": 0 },
    "timing": {
      "type": "object",
      "description": "PHASE-1.33C — bounded per-phase notebook cost and embedding cache counters. Counts and durations only; no passage bodies, queries or owner payloads.",
      "properties": {
        "retrieve_ms":         { "type": "integer", "minimum": 0 },
        "keyword_ms":          { "type": "integer", "minimum": 0 },
        "neighbor_ms":         { "type": "integer", "minimum": 0 },
        "expand_ms":           { "type": "integer", "minimum": 0 },
        "passage_count":       { "type": "integer", "minimum": 0 },
        "embed_hits_memory":   { "type": "integer", "minimum": 0 },
        "embed_hits_transient": { "type": "integer", "minimum": 0 },
        "embed_misses":        { "type": "integer", "minimum": 0 }
      }
    }
  }
}
