            "schedule": "0 7 * * *"
          }
        },
        {
          "id": "tr",
          "type": "action",
          "position": {
            "x": 320,
            "y": 80
          },
          "data": {
            "blockId": "action.trending_research",
            "label": "Deep research xu hướng marketing hôm nay",
            "topic": "xu hướng marketing, TikTok, livestream, chương trình khuyến mại, khai trương và review sản phẩm tại Việt Nam hôm nay",
            "scope": "1d",
            "platforms": "web,reddit,tiktok,youtube",
            "language": "vi",
            "output": "full"
