            "blockId": "action.reply_zalo",
            "label": "Gửi preview caption qua Zalo",
            "instance_id": "",
            "override_chat_id": "",
            "text": "✍️ Đã soạn caption:\n────────────────────\n{{gen.content}}\n\n⏳ Đang tạo ảnh minh họa, chờ xíu..."
