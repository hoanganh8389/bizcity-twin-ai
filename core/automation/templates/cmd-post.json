            "x": 960,
            "y": 80
          },
          "data": {
            "blockId": "action.generate_image",
            "label": "Tạo ảnh AI (sideload WP)",
            "prompt": "Create a professional Vietnamese social media illustration. NO text, NO words, NO letters, NO labels anywhere in the image. Visual subject: {{trigger.text}}. Style: vibrant modern flat design, clean composition, conceptual visuals only.",
            "model": "nano-banana",
            "size": "1024x1024",
            "sideload_to_wp": true
          }
        },
        {
          "id": "img_reply",
          "type": "action",
