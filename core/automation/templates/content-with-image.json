              "@đăng fb",
              "@dangfb",
              "@post fb",
              "/fb"
            ],
            "mode": "keyword_start"
          }
        },
        {
          "id": "gen",
          "type": "action",
          "position": {
            "x": 320,
            "y": 80
          },
          "data": {
            "blockId": "action.generate_content",
            "label": "Trích chủ đề + soạn hook/caption FB",
            "content_type": "fb_post",
            "notebook_id": 0,
            "prompt_template": "Tin nhắn nhận được: {{trigger.text}}\n\nBước 1: Bỏ phần lệnh ở đầu như @đăng fb, @dangfb, @post fb, /fb để lấy chủ đề thuần túy.\nBước 2: Viết caption Facebook tiếng Việt theo cấu trúc:\n- 1 câu hook mở đầu thật rõ lợi ích hoặc cảm xúc\n- 4-6 dòng nội dung chính\n- 2-4 emoji phù hợp\n- CTA nhẹ ở cuối để comment/inbox\n- 3-5 hashtag liên quan\nKhông dùng markdown, không dùng tiêu đề riêng, không giải thích thêm.",
            "tone": "",
            "max_words": 300,
            "character_id": 0
          }
        },
        {
          "id": "img",
          "type": "action",
          "position": {
            "x": 640,
            "y": 80
          },
          "data": {
            "blockId": "action.generate_image",
            "label": "Tạo ảnh minh họa",
            "prompt": "Create a professional Vietnamese Facebook post illustration. NO text, NO words, NO letters, NO labels in the image. Visual concept based on this caption: {{gen.content}}. Clean modern composition, strong product/service mood, bright social-media friendly lighting.",
            "model": "gpt-image-1",
            "size": "1024x1024",
            "sideload_to_wp": true
          }
        },
        {
          "id": "publish",
          "type": "action",
          "position": {
            "x": 960,
            "y": 80
          },
          "data": {
            "blockId": "action.publish_fb_post",
            "label": "Đăng Facebook Page",
            "fb_page_id": "",
            "fb_page_name": "",
            "content": "{{gen.content}}",
            "image_url": "{{img.image_url}}",
            "mode": "now",
            "delay_min": 0
          }
        },
        {
          "id": "reply",
          "type": "action",
          "position": {
            "x": 1280,
            "y": 80
          },
          "data": {
            "blockId": "action.reply_zalo",
            "label": "Báo kết quả qua Zalo",
            "text": "✅ Đã tạo bài Facebook và đưa vào hàng đăng ngay.\n\n📝 Caption:\n{{gen.content}}\n\n📎 Ảnh: {{img.image_url}}\n\n🔗 Link bài sẽ được gửi lại tại đây sau khi Facebook xác nhận publish xong."
          }
        }
      ],
      "edges": [
