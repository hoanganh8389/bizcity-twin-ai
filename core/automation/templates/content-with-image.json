  {
    "slug": "tpl_fb_post_with_auto_image_v1",
    "name": "[global] [content ops] Đăng FB theo chủ đề + Ảnh Auto (@đăng fb)",
    "description": "Zalo Bot nhận \"@đăng fb [chủ đề]\" → trích chủ đề → soạn hook/caption Facebook → tạo ảnh minh họa AI → đăng Facebook Page kèm ảnh. Sau import: chọn Zalo Bot + điền fb_page_id; link bài thật được Scheduler Completion Notifier gửi về kênh gốc sau khi Facebook publish xong.",
    "category": "automation",
    "source": "builtin",
    "trigger_type": "zalo_inbound",
    "icon": "Facebook",
    "tags": "zalo,facebook,publish,ai,image,generate,ondemand,global,customer",
