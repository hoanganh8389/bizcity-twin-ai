{
  "schema_version": "1.0",
  "id": "bizcity.reference",
  "package_role": "reference_only",
  "name": "BizCity Reference Extension",
  "version": "1.0.0",
  "spine": {
    "channel": { "mode": "none" },
    "crm": { "mode": "not_applicable" },
    "context_bank": { "mode": "not_applicable" },
    "knowledge": { "mode": "kg_adapter", "contracts": ["kg-adapter-payload@1.x", "citation-pack@1.x"] },
    "brain": { "mode": "not_applicable" },
    "mcp": { "mode": "none" },
    "action": { "side_effects": [] }
  },
  "evidence": {
    "probe_ids": ["examples.reference.runtime_smoke"],
    "negative_cases": ["wrong_tenant", "missing_consent"]
  },
  "taxonomy": ["act", "channel", "view"],
  "primary_taxonomy": "act",
  "diagnostics": true,
  "logging": {
    "contracts": ["plugins.bizcity_reference.wave5"]
  },
  "requires": {
    "framework": ">=1.1.0",
    "php": ">=7.4",
    "wp": ">=6.0"
  },
  "permissions": [
    "kg.read",
    "kg.write",
    "memory.read",
    "content.publish",
    "channel.zalo.send",
    "woocommerce.order.create"
  ],
  "scope_bindings": [
    { "permission": "kg.read", "scope_level": "tenant" },
    { "permission": "kg.write", "scope_level": "tenant" },
    { "permission": "memory.read", "scope_level": "user" },
    { "permission": "content.publish", "scope_level": "user" },
    { "permission": "channel.zalo.send", "scope_level": "user" },
    { "permission": "woocommerce.order.create", "scope_level": "user" }
  ],
  "approval_gates": [
    "publish_content",
    "send_message",
    "create_order"
  ],
  "security": {
    "webhook_signature": {
      "required": true,
      "algorithm": "hmac-sha256",
      "header": "x-bizcity-signature"
    },
    "secret_refs": [
      "BIZCITY_CHANNEL_ZALO_SECRET",
      "BIZCITY_WOO_COMMERCE_SECRET"
    ],
    "network_policy": {
      "allow_hosts": [
        "api.zalo.me",
        "api.bizcity.vn"
      ],
      "block_private_ranges": true
    },
    "upload_policy": {
      "allowed_mime": [
        "image/png",
        "image/jpeg",
        "application/pdf"
      ],
      "max_bytes": 5242880,
      "scan_required": true
    }
  },
  "navigation": [
    {
      "id": "reference.workspace",
      "slug": "bizcity-reference",
      "label": "Reference Workspace",
      "group": "workspace",
      "slot": "workspace.extensions",
      "parent": "bizcity-twin-workspace",
      "capability": "manage_options",
      "position": 900,
      "scope": "site",
      "surface": "admin_page",
      "renderer": "reference.workspace",
      "visible": true,
      "origin": "extension",
      "zone": "system",
      "aliases": ["bizcity-reference-legacy"],
      "legacy_parents": ["bizcity-twinchat"]
    }
  ],
  "setting_panel": [
    {
      "contract": "setting-panel-registration",
      "version": "1.0.0",
      "id": "extension.reference.settings",
      "owner": "examples/bizcity-reference-plugin",
      "origin": "extension",
      "destination": "control-panel",
      "group": "extensions",
      "label_key": "reference.settings.label",
      "description_key": "reference.settings.description",
      "icon": "cil-puzzle",
      "capability": "manage_options",
      "scope": "site",
      "surface": "admin_page",
      "renderer": {
        "type": "deep_link",
        "id": "extension.reference.settings",
        "canonical_slug": "bizcity-reference"
      },
      "availability": {
        "policy": "registered-owner",
        "dependency_ids": ["bizcity.reference"]
      },
      "position": 900,
      "keywords": ["reference", "fixture", "contract"],
      "badge": "beta",
      "zone": "system"
    }
  ],
  "capabilities": {
    "tools": [
      {
        "id": "reference.echo",
        "label": "Echo input",
        "description": "Returns a sanitized input for contract testing.",
        "class": "BizCity_Reference_Echo_Tool",
        "primary": true,
        "owner": "examples/bizcity-reference-plugin",
        "scope": "tenant",
        "contract_id": "tool-io-envelope",
        "contract_version": "1.0.0",
        "schema": {
          "description": "Echo input",
          "input_fields": {
            "text": { "type": "string", "required": true }
          },
          "output_fields": {
            "text": { "type": "string" }
          }
        }
      }
    ],
    "skills": [
      {
        "id": "reference.skill",
        "label": "Reference skill",
        "class": "BizCity_Reference_Skill",
        "owner": "examples/bizcity-reference-plugin",
        "scope": "tenant",
        "contract_id": "tool-io-envelope",
        "contract_version": "1.0.0"
      }
    ],
    "agents": [
      {
        "id": "reference.agent",
        "label": "Reference agent",
        "class": "BizCity_Reference_Agent",
        "owner": "examples/bizcity-reference-plugin",
        "scope": "user",
        "contract_id": "runtime-execution-policy",
        "contract_version": "1.0.0"
      }
    ],
    "channels": [
      {
        "id": "reference.channel",
        "label": "Reference channel",
        "class": "BizCity_Reference_Channel",
        "zone": "admin",
        "owner": "examples/bizcity-reference-plugin",
        "scope": "tenant",
        "contract_id": "channel-payload",
        "contract_version": "1.1.0"
      }
    ],
    "kg_source_adapters": [
      {
        "id": "reference.source",
        "label": "Reference source",
        "class": "BizCity_Reference_Source_Adapter",
        "owner": "examples/bizcity-reference-plugin",
        "scope": "tenant",
        "contract_id": "kg-adapter-payload",
        "contract_version": "1.0.0"
      }
    ],
    "workflow_blocks": [
      {
        "id": "reference.echo",
        "label": "Reference workflow block",
        "class": "BizCity_Reference_Workflow_Block",
        "owner": "examples/bizcity-reference-plugin",
        "scope": "tenant",
        "contract_id": "workflow-json",
        "contract_version": "1.0.0"
      }
    ],
    "personas": [
      {
        "id": "reference.persona",
        "label": "Reference persona",
        "class": "BizCity_Reference_Persona",
        "owner": "examples/bizcity-reference-plugin",
        "scope": "user",
        "contract_id": "runtime-execution-policy",
        "contract_version": "1.0.0"
      }
    ],
    "output_renderers": [
      {
        "id": "reference.text",
        "label": "Reference text renderer",
        "class": "BizCity_Reference_Text_Renderer",
        "artifact_type": "text",
        "owner": "examples/bizcity-reference-plugin",
        "scope": "user",
        "contract_id": "tool-io-envelope",
        "contract_version": "1.0.0"
      }
    ]
  }
}
