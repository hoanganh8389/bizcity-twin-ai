{
  "contract": "pipeline-definition",
  "version": "1.0.0",
  "kind": "production",
  "label": "Sản xuất",
  "subject": "contact",
  "clock": "calendar:factory_shift_a",
  "lock_version": true,
  "pause_when": [
    "flag(waiting_customer)",
    "flag(machine_down)"
  ],
  "roles": {
    "R01": { "label": "Ban giám đốc", "resolve": { "relation": "owner_of_run" } },
    "R02": { "label": "Kế hoạch", "resolve": { "relation": "creator_of_run" } },
    "R03": { "label": "Kế toán", "resolve": { "relation": "assignee_of_stage" } },
    "R04": { "label": "Thiết kế", "resolve": { "relation": "assignee_of_stage" } },
    "R05": { "label": "Kho", "resolve": { "relation": "assignee_of_stage" } },
    "R06b": { "label": "Tổ sản xuất", "resolve": { "relation": "assignee_of_stage" } },
    "R07": { "label": "Thương mại", "resolve": { "relation": "assignee_of_stage" } },
    "R08": { "label": "Kỹ thuật", "resolve": { "relation": "assignee_of_stage" } },
    "R09": { "label": "QAQC", "resolve": { "relation": "assignee_of_stage" } },
    "shift_lead": { "label": "Trưởng ca", "resolve": { "relation": "team_lead_of_assignee" } }
  },
  "calendars": {
    "factory_shift_a": [
      { "dow": [1, 2, 3, 4, 5, 6], "from": "06:00", "to": "14:00" }
    ]
  },
  "tools": ["stage", "ops", "work", "documents", "activity"],
  "stages": [
    {
      "key": "GD1",
      "label": "Khởi tạo",
      "role": "R02",
      "sub_steps": [
        { "key": "P1.1", "label": "Tiếp nhận yêu cầu sản xuất", "mode": "task", "role": "R02" },
        { "key": "P1.1B", "label": "Duyệt tiếp nhận", "mode": "task", "role": "R01" },
        { "key": "P1.2A", "label": "Khai báo thông tin đơn", "mode": "task", "role": "R02" },
        { "key": "P1.2", "label": "Xác nhận điều kiện thanh toán", "mode": "task", "role": "R03" },
        { "key": "P1.3", "label": "Duyệt khởi tạo lệnh", "mode": "task", "role": "R01" }
      ]
    },
    {
      "key": "GD2",
      "label": "Thiết kế & Dự toán",
      "role": "R04",
      "sub_steps": [
        { "key": "P2.1", "label": "Bản vẽ thiết kế", "mode": "task", "role": "R04" },
        { "key": "P2.2", "label": "Định mức vật tư", "mode": "task", "role": "R02" },
        { "key": "P2.3", "label": "Kiểm tồn kho", "mode": "task", "role": "R05" },
        { "key": "P2.1A", "label": "Thẩm định kỹ thuật", "mode": "task", "role": "R08" },
        { "key": "P2.4", "label": "Dự toán giá thành", "mode": "task", "role": "R03" },
        { "key": "P2.5", "label": "Duyệt dự toán", "mode": "task", "role": "R01" }
      ],
      "sla": {
        "finish_within": {
          "from": "stage_ready",
          "within": "+2d",
          "on_miss": [
            { "at": "-20%", "do": "flag(at_risk)" },
            { "at": "0", "do": "escalate(role:shift_lead)" }
          ]
        }
      }
    },
    {
      "key": "GD3",
      "label": "Chuẩn bị vật tư",
      "role": "R02",
      "sub_steps": [
        { "key": "P3.1", "label": "Lập kế hoạch vật tư", "mode": "task", "role": "R02" },
        { "key": "P3.3", "label": "Đề nghị mua vật tư thiếu", "mode": "task", "role": "R02" },
        { "key": "P3.4", "label": "Theo dõi tiến độ vật tư", "mode": "task", "role": "R02" },
        { "key": "P3.5", "label": "Đặt hàng nhà cung cấp", "mode": "task", "role": "R07" },
        { "key": "P3.6", "label": "Duyệt đủ điều kiện sản xuất", "mode": "task", "role": "R01" }
      ],
      "sla": {
        "pause_when": ["flag(waiting_vendor)"],
        "finish_within": {
          "from": "stage_ready",
          "within": "+3d",
          "on_miss": [{ "at": "0", "do": "notify(role:R02) + escalate(role:shift_lead)" }]
        }
      }
    },
    {
      "key": "GD4",
      "label": "Nhận hàng & Nhập kho",
      "role": "R05",
      "sub_steps": [
        { "key": "P4.5", "label": "Nhập kho vật tư", "mode": "task", "role": "R05" },
        { "key": "P4.1", "label": "Nhận hàng tại cổng", "mode": "status_only" },
        { "key": "P4.2", "label": "Đối chiếu phiếu giao", "mode": "status_only" },
        { "key": "P4.3", "label": "Kiểm đếm số lượng", "mode": "status_only" },
        { "key": "P4.4", "label": "Kiểm tra chất lượng đầu vào", "mode": "status_only" }
      ],
      "requires": { "evidence": ["photo"], "min_count": 1 }
    },
    {
      "key": "GD5",
      "label": "Sản xuất",
      "role": "R06b",
      "sub_steps": [
        { "key": "P5.2", "label": "Thi công theo lệnh", "mode": "task", "role": "R06b" },
        { "key": "P5.3", "label": "QC trong chuyền", "mode": "task", "role": "R09" },
        { "key": "P5.4", "label": "Cập nhật tiến độ", "mode": "task", "role": "R02" },
        { "key": "P5.5", "label": "Ghi nhận chi phí phát sinh", "mode": "task", "role": "R03" }
      ],
      "sla": {
        "start_within": {
          "within": "+15m",
          "on_miss": [{ "at": "0", "do": "notify(role:R09) + flag(breached)" }]
        },
        "finish_within": {
          "from": "stage_ready",
          "within": "+45m",
          "on_miss": [
            { "at": "-20%", "do": "flag(at_risk)" },
            { "at": "0", "do": "escalate(role:shift_lead)" }
          ]
        }
      },
      "requires": { "fields": ["qc_result"], "evidence": ["photo"], "min_count": 1 }
    },
    {
      "key": "GD6",
      "label": "Đóng dự án",
      "role": "R02",
      "terminal": true,
      "sub_steps": [
        { "key": "P6.1", "label": "Nghiệm thu nội bộ", "mode": "task", "role": "R09" },
        { "key": "P6.2", "label": "Hồ sơ kỹ thuật bàn giao", "mode": "task", "role": "R08" },
        { "key": "P6.3", "label": "Quyết toán chi phí", "mode": "task", "role": "R03" },
        { "key": "P6.4", "label": "Cập nhật kết quả lệnh", "mode": "task", "role": "R02" },
        { "key": "P6.5", "label": "Duyệt đóng dự án", "mode": "task", "role": "R01" }
      ]
    }
  ],
  "gates": [
    { "stage": "P2.4", "requires": { "all_of": ["P2.1", "P2.2", "P2.3", "P2.1A"] } },
    { "stage": "P3.6", "requires": { "all_of": ["P3.3", "P3.5"] } },
    { "stage": "GD5", "requires": { "all_of": ["GD3", "GD4"] } },
    { "stage": "P6.5", "requires": { "all_of": ["P6.1", "P6.2", "P6.3", "P6.4"] } }
  ],
  "rules": [
    {
      "id": "qc_start",
      "layer": "wait",
      "anchor": "stage_ready(P5.3)",
      "offset": "+15m",
      "target": "stage_started(P5.3)",
      "on_miss": [{ "at": "0", "do": "notify(role:R09) + flag(breached)" }]
    },
    {
      "id": "qc_finish",
      "layer": "step",
      "anchor": "stage_ready(P5.3)",
      "offset": "+45m",
      "target": "stage_done(P5.3)",
      "on_miss": [
        { "at": "-20%", "do": "flag(at_risk)" },
        { "at": "0", "do": "escalate(role:shift_lead)" }
      ]
    }
  ],
  "process_sla": {
    "id": "production_lead_time",
    "layer": "process",
    "anchor": "run_created",
    "offset": "+18h",
    "target": "stage_done(GD6)",
    "on_miss": [
      { "at": "-10%", "do": "notify(role:R02)" },
      { "at": "0", "do": "escalate(role:R01)" }
    ]
  },
  "exceptions": [
    {
      "key": "qc_fail",
      "label": "QC không đạt",
      "raised_from": ["P5.3", "P6.1"],
      "handler_role": "R08",
      "blocks_stage": true,
      "sla": [
        {
          "id": "ack",
          "layer": "exception",
          "anchor": "exception_raised",
          "offset": "+10m",
          "target": "exception_ack",
          "clock": "24x7",
          "on_miss": [
            { "at": "+10m", "do": "escalate(role:shift_lead)" },
            { "at": "+35m", "do": "escalate(role:R01)" }
          ]
        },
        {
          "id": "resolve",
          "layer": "exception",
          "anchor": "exception_raised",
          "offset": "+2h",
          "target": "exception_resolved",
          "clock": "24x7",
          "on_miss": [{ "at": "0", "do": "escalate(role:R01)" }]
        }
      ]
    },
    {
      "key": "machine_down",
      "label": "Máy hỏng",
      "raised_from": ["P5.2"],
      "handler_role": "R08",
      "blocks_stage": true,
      "sla": [
        {
          "id": "ack",
          "layer": "exception",
          "anchor": "exception_raised",
          "offset": "+10m",
          "target": "exception_ack",
          "clock": "24x7",
          "on_miss": [{ "at": "0", "do": "escalate(role:shift_lead)" }]
        }
      ]
    },
    {
      "key": "material_short",
      "label": "Thiếu vật tư",
      "raised_from": ["P3.1", "P5.2"],
      "handler_role": "R05",
      "blocks_stage": true,
      "sla": [
        {
          "id": "ack",
          "layer": "exception",
          "anchor": "exception_raised",
          "offset": "+30m",
          "target": "exception_ack",
          "on_miss": [{ "at": "0", "do": "notify(role:R02) + escalate(role:shift_lead)" }]
        }
      ]
    }
  ]
}
