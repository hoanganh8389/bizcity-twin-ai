{
  "contract": "context-bank-query-fixtures",
  "version": "1.0.0",
  "status": "CB0.3 baseline",
  "date": "2026-09-01",
  "owner": "Twin AI Core",
  "purpose": "Bounded query shapes for Context Bank ledger and retrieval design before CB3 indexes are approved.",
  "rules": {
    "tenant_scope_required": true,
    "cross_tenant_search": false,
    "metadata_before_pointer_follow": true,
    "raw_payload_in_response": false,
    "posted_owner_fields_are_not_acl": true,
    "synthetic_ids_only": true
  },
  "fixtures": [
