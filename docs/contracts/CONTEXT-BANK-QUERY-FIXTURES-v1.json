      "fixture_id": "recent_identity_case_7d",
      "description": "Recent events for one authorized identity and case.",
      "tenant": { "blog_id": 101, "database": "shard_alpha" },
      "actor": { "wp_user_id": 701, "role": "staff" },
      "scope": { "identity_uuid": "id_synthetic_alpha_701", "case_id": "case_synthetic_1001" },
      "filters": { "record_kind": "event", "occurred_from": "2026-08-25T00:00:00Z", "occurred_to": "2026-09-01T23:59:59Z", "status": "active" },
      "expected_authorization": "allow_current_tenant_identity_case",
      "expected_ordering": "occurred_at_desc_id_desc",
      "maximum_rows": 100,
      "maximum_pointer_follows": 8,
      "maximum_decrypted_bytes": 32768,
      "maximum_response_time_ms": 250,
      "expected_degraded_behavior": "return_metadata_with_incomplete_true_when_pointer_budget_is_exhausted"
    },
    {
